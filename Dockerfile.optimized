# Optimized Dockerfile for Lambda functions with minimal dependencies
# This builds each function with ONLY the dependencies it needs

# checkov:skip=CKV_DOCKER_3: "The Dockerfile uses the official AWS Lambda Python base image which already configures the appropriate non-root user for Lambda execution"
# checkov:skip=CKV_DOCKER_2: "The Dockerfile.optimized is specifically designed for AWS Lambda container images, which don't use Docker HEALTHCHECK instructions."

# Architecture selection: pass --build-arg BASE_IMAGE_SUFFIX=x86_64 for AMD64
ARG BASE_IMAGE_SUFFIX=arm64

# Registry override: pass --build-arg UV_IMAGE=your-registry.com/uv:0.9.6 for internal mirrors
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.6

# Base image override: pass --build-arg BASE_IMAGE_REGISTRY=your-registry.com/lambda/python for internal mirrors
ARG BASE_IMAGE_REGISTRY=public.ecr.aws/lambda/python

# Use specific version to avoid network issues
FROM ${UV_IMAGE} AS uv

# Builder stage - bundle dependencies into Lambda task root
FROM ${BASE_IMAGE_REGISTRY}:3.12-${BASE_IMAGE_SUFFIX} AS builder

# Enable bytecode compilation to improve cold-start performance
ENV UV_COMPILE_BYTECODE=1

# Disable installer metadata to create a deterministic layer
ENV UV_NO_INSTALLER_METADATA=1

# Enable copy mode to support bind mount caching
ENV UV_LINK_MODE=copy

# Build argument for function path
ARG FUNCTION_PATH
ARG INSTALL_IDP_COMMON=true
ARG INSTALL_GIT=false

# Create working directory
WORKDIR /build

# Copy uv binary from uv stage
COPY --from=uv /uv /usr/local/bin/uv

# Copy idp_common_pkg and requirements for installation
COPY lib/idp_common_pkg /tmp/idp_common_pkg
COPY ${FUNCTION_PATH}/requirements.txt* /build/

# Install all dependencies including idp_common_pkg in one step
# Secret mounts allow authenticated access to private PyPI registries
# When no secrets are provided (standard deployment), mounts are empty and ignored
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=secret,id=pipconf,target=/etc/pip.conf \
    --mount=type=secret,id=uvconf,target=/root/.config/uv/uv.toml \
    --mount=type=secret,id=cacert,target=/etc/pki/ca-trust/source/anchors/custom-ca.crt \
  if [ -f /etc/pki/ca-trust/source/anchors/custom-ca.crt ] && [ -s /etc/pki/ca-trust/source/anchors/custom-ca.crt ]; then \
    update-ca-trust extract; \
  fi && \
  if [ -f /build/requirements.txt ]; then \
  sed 's|^\.\./\.\.\(/\.\.\)\?/lib/idp_common_pkg|/tmp/idp_common_pkg|' /build/requirements.txt > /tmp/requirements.txt && \
  uv pip install --python python3.12 --target "${LAMBDA_TASK_ROOT}" -r /tmp/requirements.txt && \
  rm /tmp/requirements.txt; \
  fi && \
  rm -rf /tmp/idp_common_pkg

# Final stage - minimal runtime
ARG BASE_IMAGE_REGISTRY=public.ecr.aws/lambda/python
ARG BASE_IMAGE_SUFFIX=arm64
FROM ${BASE_IMAGE_REGISTRY}:3.12-${BASE_IMAGE_SUFFIX}

# Conditionally install git (required for mlflow/gitpython)
ARG INSTALL_GIT=false
RUN if [ "$INSTALL_GIT" = "true" ]; then dnf install -y git && dnf clean all; fi

# Copy the runtime dependencies from the builder stage
COPY --from=builder ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Copy function code
ARG FUNCTION_PATH
COPY ${FUNCTION_PATH}/*.py ${LAMBDA_TASK_ROOT}/

# Set handler
CMD ["index.handler"]

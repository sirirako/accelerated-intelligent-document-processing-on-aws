# Copy to .env_activemq and fill in values

# ActiveMQ broker
MQ_HOST=amq-broker.example.com
MQ_PORT=61617
MQ_DESTINATION=/queue/idp.document.completed
MQ_DISABLE_HOST_VERIFY=false

# Ping token (ROPC grant)
PING_TOKEN_URL=https://ping.example.com/as/token.oauth2
PING_CLIENT_ID=<client-id>
PING_CLIENT_SECRET=<client-secret>
PING_USERNAME=<ad-username>
PING_PASSWORD=<ad-password>
PING_SCOPE=
PING_VALIDATOR_ID=

# TLS — two independent trust paths, matching the Lambda's env vars.
# Under TLS inspection both usually point at the same corporate CA bundle, but
# they are separate because the Ping endpoint and the broker can be re-signed
# by different issuers.
#
# CA bundle for the Ping token endpoint
CA_CERT_PATH=
# CA bundle for the ActiveMQ broker (falls back to CA_CERT_PATH if unset)
MQ_CA_CERT_PATH=
